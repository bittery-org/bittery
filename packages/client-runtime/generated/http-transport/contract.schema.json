{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "HttpTransportContract",
  "type": "object",
  "properties": {
    "request": {
      "$ref": "#/$defs/HttpRequest"
    },
    "response": {
      "$ref": "#/$defs/HttpResponse"
    }
  },
  "required": [
    "request",
    "response"
  ],
  "$defs": {
    "HttpHeader": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "value": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "name",
        "value"
      ]
    },
    "HttpMethod": {
      "type": "string",
      "enum": [
        "GET",
        "HEAD",
        "POST",
        "PUT",
        "PATCH",
        "DELETE"
      ]
    },
    "HttpRequest": {
      "type": "object",
      "properties": {
        "body": {
          "type": "array",
          "items": {
            "type": "integer",
            "format": "uint8",
            "maximum": 255,
            "minimum": 0
          }
        },
        "dispatchId": {
          "type": "string",
          "minLength": 1
        },
        "headers": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/HttpHeader"
          }
        },
        "maxResponseBytes": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "method": {
          "$ref": "#/$defs/HttpMethod"
        },
        "url": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "dispatchId",
        "method",
        "url",
        "headers",
        "body",
        "maxResponseBytes"
      ]
    },
    "HttpResponse": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "body": {
              "type": "array",
              "items": {
                "type": "integer",
                "format": "uint8",
                "maximum": 255,
                "minimum": 0
              }
            },
            "headers": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/HttpHeader"
              }
            },
            "status": {
              "type": "integer",
              "format": "uint16",
              "maximum": 599,
              "minimum": 0
            },
            "type": {
              "type": "string",
              "const": "completed"
            }
          },
          "additionalProperties": false,
          "required": [
            "type",
            "status",
            "headers",
            "body"
          ]
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "networkFailure"
            }
          },
          "additionalProperties": false,
          "required": [
            "type"
          ]
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "responseTooLarge"
            }
          },
          "additionalProperties": false,
          "required": [
            "type"
          ]
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "cancelled"
            }
          },
          "additionalProperties": false,
          "required": [
            "type"
          ]
        }
      ]
    }
  },
  "$id": "urn:bittery:client-runtime:http-transport"
}
