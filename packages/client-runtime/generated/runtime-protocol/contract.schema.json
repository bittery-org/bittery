{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "RuntimeProtocolContract",
  "type": "object",
  "properties": {
    "observation": {
      "$ref": "#/$defs/ObservationRequest"
    },
    "outcome": {
      "$ref": "#/$defs/RuntimeOutcome"
    },
    "projection": {
      "$ref": "#/$defs/RuntimeProjection"
    },
    "request": {
      "$ref": "#/$defs/RuntimeRequest"
    }
  },
  "required": [
    "request",
    "outcome",
    "observation",
    "projection"
  ],
  "$defs": {
    "AccountAccessState": {
      "type": "string",
      "enum": [
        "signedOut",
        "locked",
        "unlocked"
      ]
    },
    "AccountDisplayIdentity": {
      "description": "The non-secret identity a host may render for one installed Account.",
      "type": "object",
      "properties": {
        "email": {
          "type": "string"
        }
      },
      "required": [
        "email"
      ]
    },
    "AccountStatus": {
      "type": "object",
      "properties": {
        "access": {
          "$ref": "#/$defs/AccountAccessState"
        },
        "accountId": {
          "type": "string"
        },
        "displayIdentity": {
          "anyOf": [
            {
              "$ref": "#/$defs/AccountDisplayIdentity"
            },
            {
              "type": "null"
            }
          ]
        },
        "failure": {
          "anyOf": [
            {
              "$ref": "#/$defs/RuntimeErrorCode"
            },
            {
              "type": "null"
            }
          ]
        },
        "replicaRevision": {
          "type": "string",
          "pattern": "^(?:0|[1-9][0-9]{0,18}|(?:1[0-7][0-9]{18}|18[0-3][0-9]{17}|184[0-3][0-9]{16}|1844[0-5][0-9]{15}|18446[0-6][0-9]{14}|184467[0-3][0-9]{13}|1844674[0-3][0-9]{12}|184467440[0-6][0-9]{10}|1844674407[0-2][0-9]{9}|18446744073[0-6][0-9]{8}|1844674407370[0-8][0-9]{6}|18446744073709[0-4][0-9]{5}|184467440737095[0-4][0-9]{4}|18446744073709550[0-9]{3}|18446744073709551[0-5][0-9]{2}|1844674407370955160[0-9]{1}|1844674407370955161[0-4][0-9]{0}|18446744073709551615))$"
        },
        "waitingReason": {
          "anyOf": [
            {
              "$ref": "#/$defs/AccountWaitingReason"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "accountId",
        "replicaRevision",
        "access",
        "failure"
      ]
    },
    "AccountWaitingReason": {
      "type": "string",
      "enum": [
        "reauthenticationRequired"
      ]
    },
    "AttachmentProjection": {
      "type": "object",
      "properties": {
        "accountId": {
          "type": "string"
        },
        "attachmentId": {
          "type": "string"
        },
        "contentType": {
          "type": "string"
        },
        "createdAt": {
          "type": "string"
        },
        "fileSize": {
          "type": "integer",
          "maximum": 2147483647,
          "minimum": -2147483648
        },
        "itemId": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "storageKey": {
          "type": "string"
        },
        "uploadedBy": {
          "type": "string"
        },
        "vaultId": {
          "type": "string"
        }
      },
      "required": [
        "accountId",
        "attachmentId",
        "itemId",
        "vaultId",
        "storageKey",
        "name",
        "contentType",
        "fileSize",
        "uploadedBy",
        "createdAt"
      ]
    },
    "CreateShareDraft": {
      "type": "object",
      "properties": {
        "accessMode": {
          "$ref": "#/$defs/ShareAccessMode"
        },
        "allowedEmails": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "expiresIn": {
          "$ref": "#/$defs/ShareExpiration"
        },
        "isOneTimeUse": {
          "type": "boolean",
          "default": false
        }
      },
      "required": [
        "accessMode",
        "expiresIn",
        "isOneTimeUse"
      ]
    },
    "CustomFieldKind": {
      "type": "string",
      "enum": [
        "text",
        "password",
        "email",
        "url"
      ]
    },
    "ItemProjectionStatus": {
      "type": "string",
      "enum": [
        "pending",
        "authoritative",
        "failed"
      ]
    },
    "ItemsProjection": {
      "type": "object",
      "properties": {
        "accountId": {
          "type": "string"
        },
        "items": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/LoginItemProjection"
          }
        },
        "replicaRevision": {
          "type": "string",
          "pattern": "^(?:0|[1-9][0-9]{0,18}|(?:1[0-7][0-9]{18}|18[0-3][0-9]{17}|184[0-3][0-9]{16}|1844[0-5][0-9]{15}|18446[0-6][0-9]{14}|184467[0-3][0-9]{13}|1844674[0-3][0-9]{12}|184467440[0-6][0-9]{10}|1844674407[0-2][0-9]{9}|18446744073[0-6][0-9]{8}|1844674407370[0-8][0-9]{6}|18446744073709[0-4][0-9]{5}|184467440737095[0-4][0-9]{4}|18446744073709550[0-9]{3}|18446744073709551[0-5][0-9]{2}|1844674407370955160[0-9]{1}|1844674407370955161[0-4][0-9]{0}|18446744073709551615))$"
        },
        "vaults": {
          "description": "The Vaults these Items live in, so a host can name one and can tell a reader from a\nwriter without asking a second source. Present for the first slice's create affordance;\nfull Vault metadata still belongs to the read path that owns it.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/VaultProjection"
          }
        }
      },
      "required": [
        "accountId",
        "replicaRevision",
        "items",
        "vaults"
      ]
    },
    "LoginCustomField": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "label": {
          "type": "string"
        },
        "type": {
          "$ref": "#/$defs/CustomFieldKind"
        },
        "value": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "label",
        "value",
        "type"
      ]
    },
    "LoginItemDraft": {
      "type": "object",
      "properties": {
        "customFields": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/LoginCustomField"
          }
        },
        "note": {
          "type": [
            "string",
            "null"
          ]
        },
        "notes": {
          "type": [
            "string",
            "null"
          ]
        },
        "password": {
          "type": [
            "string",
            "null"
          ]
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "title": {
          "type": "string"
        },
        "url": {
          "type": [
            "string",
            "null"
          ]
        },
        "urls": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "username": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "title"
      ]
    },
    "LoginItemProjection": {
      "type": "object",
      "properties": {
        "accountId": {
          "type": "string"
        },
        "attachments": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/AttachmentProjection"
          }
        },
        "createdAt": {
          "type": "string"
        },
        "customFields": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/LoginCustomField"
          }
        },
        "deletedAt": {
          "type": [
            "string",
            "null"
          ]
        },
        "favorite": {
          "type": "boolean"
        },
        "itemId": {
          "type": "string"
        },
        "note": {
          "type": [
            "string",
            "null"
          ]
        },
        "notes": {
          "type": [
            "string",
            "null"
          ]
        },
        "password": {
          "type": [
            "string",
            "null"
          ]
        },
        "status": {
          "$ref": "#/$defs/ItemProjectionStatus"
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "title": {
          "type": "string"
        },
        "updatedAt": {
          "type": "string"
        },
        "url": {
          "type": [
            "string",
            "null"
          ]
        },
        "urls": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "username": {
          "type": [
            "string",
            "null"
          ]
        },
        "vaultId": {
          "type": "string"
        }
      },
      "required": [
        "accountId",
        "itemId",
        "vaultId",
        "title",
        "favorite",
        "createdAt",
        "updatedAt",
        "status"
      ]
    },
    "ObservationRequest": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "accountId": {
              "type": "string"
            },
            "type": {
              "type": "string",
              "const": "items"
            }
          },
          "required": [
            "type",
            "accountId"
          ]
        },
        {
          "type": "object",
          "properties": {
            "accountId": {
              "type": "string"
            },
            "type": {
              "type": "string",
              "const": "pendingShareResults"
            }
          },
          "required": [
            "type",
            "accountId"
          ]
        },
        {
          "type": "object",
          "properties": {
            "accountId": {
              "type": [
                "string",
                "null"
              ]
            },
            "type": {
              "type": "string",
              "const": "runtimeStatus"
            }
          },
          "required": [
            "type",
            "accountId"
          ]
        }
      ]
    },
    "PendingShareResult": {
      "type": "object",
      "properties": {
        "expiresAt": {
          "type": "string"
        },
        "itemId": {
          "type": "string"
        },
        "operationId": {
          "type": "string"
        },
        "shareLinkId": {
          "type": "string"
        },
        "shareUrl": {
          "type": "string"
        }
      },
      "required": [
        "operationId",
        "itemId",
        "shareLinkId",
        "shareUrl",
        "expiresAt"
      ]
    },
    "PendingShareResultsProjection": {
      "type": "object",
      "properties": {
        "accountId": {
          "type": "string"
        },
        "replicaRevision": {
          "type": "string",
          "pattern": "^(?:0|[1-9][0-9]{0,18}|(?:1[0-7][0-9]{18}|18[0-3][0-9]{17}|184[0-3][0-9]{16}|1844[0-5][0-9]{15}|18446[0-6][0-9]{14}|184467[0-3][0-9]{13}|1844674[0-3][0-9]{12}|184467440[0-6][0-9]{10}|1844674407[0-2][0-9]{9}|18446744073[0-6][0-9]{8}|1844674407370[0-8][0-9]{6}|18446744073709[0-4][0-9]{5}|184467440737095[0-4][0-9]{4}|18446744073709550[0-9]{3}|18446744073709551[0-5][0-9]{2}|1844674407370955160[0-9]{1}|1844674407370955161[0-4][0-9]{0}|18446744073709551615))$"
        },
        "results": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/PendingShareResult"
          }
        }
      },
      "required": [
        "accountId",
        "replicaRevision",
        "results"
      ]
    },
    "RuntimeError": {
      "type": "object",
      "properties": {
        "code": {
          "$ref": "#/$defs/RuntimeErrorCode"
        },
        "message": {
          "type": "string"
        }
      },
      "required": [
        "code",
        "message"
      ]
    },
    "RuntimeErrorCode": {
      "type": "string",
      "enum": [
        "RUNTIME_CLOSED",
        "CANCELLED",
        "ACCOUNT_MISSING",
        "ACCOUNT_ALREADY_INSTALLED",
        "ACCOUNT_FAILED",
        "AUTHENTICATION_REQUIRED",
        "AUTHENTICATION_UNAVAILABLE",
        "INVARIANT_VIOLATION"
      ]
    },
    "RuntimeOutcome": {
      "description": "The declared envelope every external Runtime request answers with.\n\nSerde would otherwise emit its externally tagged `Result` spelling, an implicit wire shape no\ncontract describes. This adjacent tagging matches `RuntimeProjection`, and it keeps the\nsuccess payload intact: `RuntimeResponse` is itself internally tagged on `type`, so an\ninternally tagged envelope would collide with it.",
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "succeeded"
            },
            "value": {
              "$ref": "#/$defs/RuntimeResponse"
            }
          },
          "required": [
            "type",
            "value"
          ]
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "failed"
            },
            "value": {
              "$ref": "#/$defs/RuntimeError"
            }
          },
          "required": [
            "type",
            "value"
          ]
        }
      ]
    },
    "RuntimeProjection": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "items"
            },
            "value": {
              "$ref": "#/$defs/ItemsProjection"
            }
          },
          "required": [
            "type",
            "value"
          ]
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "pendingShareResults"
            },
            "value": {
              "$ref": "#/$defs/PendingShareResultsProjection"
            }
          },
          "required": [
            "type",
            "value"
          ]
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "runtimeStatus"
            },
            "value": {
              "$ref": "#/$defs/RuntimeStatusProjection"
            }
          },
          "required": [
            "type",
            "value"
          ]
        }
      ]
    },
    "RuntimeRequest": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "email": {
              "type": "string"
            },
            "insecureTransportConfirmed": {
              "type": "boolean"
            },
            "masterPassword": {
              "type": "string"
            },
            "secretKey": {
              "type": "string"
            },
            "serverUrl": {
              "type": "string"
            },
            "type": {
              "type": "string",
              "const": "signIn"
            }
          },
          "additionalProperties": false,
          "required": [
            "type",
            "serverUrl",
            "email",
            "masterPassword",
            "secretKey",
            "insecureTransportConfirmed"
          ]
        },
        {
          "type": "object",
          "properties": {
            "accountId": {
              "type": "string"
            },
            "masterPassword": {
              "type": "string"
            },
            "type": {
              "type": "string",
              "const": "quickUnlock"
            }
          },
          "additionalProperties": false,
          "required": [
            "type",
            "accountId",
            "masterPassword"
          ]
        },
        {
          "description": "Retires this Account's live keys and plaintext delivery while the Device keeps the\nmaterial one master password reopens.",
          "type": "object",
          "properties": {
            "accountId": {
              "type": "string"
            },
            "type": {
              "type": "string",
              "const": "lock"
            }
          },
          "additionalProperties": false,
          "required": [
            "type",
            "accountId"
          ]
        },
        {
          "description": "Ends local ownership: the same retirement as `Lock`, and the Device forgets the\nQuick Unlock material and Session, so this Account needs a full Sign-in again.",
          "type": "object",
          "properties": {
            "accountId": {
              "type": "string"
            },
            "type": {
              "type": "string",
              "const": "signOut"
            }
          },
          "additionalProperties": false,
          "required": [
            "type",
            "accountId"
          ]
        },
        {
          "description": "Irreversibly removes exactly the explicitly named Account from this Device.",
          "type": "object",
          "properties": {
            "accountId": {
              "type": "string",
              "pattern": "^[\\s\\S]+$"
            },
            "type": {
              "type": "string",
              "const": "removeAccount"
            }
          },
          "additionalProperties": false,
          "required": [
            "type",
            "accountId"
          ]
        },
        {
          "description": "Irreversibly removes every Runtime-owned Account and Device record.",
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "wipe"
            }
          },
          "additionalProperties": false,
          "required": [
            "type"
          ]
        },
        {
          "type": "object",
          "properties": {
            "accountId": {
              "type": "string"
            },
            "draft": {
              "$ref": "#/$defs/LoginItemDraft"
            },
            "type": {
              "type": "string",
              "const": "createLoginItem"
            },
            "vaultId": {
              "type": "string"
            }
          },
          "additionalProperties": false,
          "required": [
            "type",
            "accountId",
            "vaultId",
            "draft"
          ]
        },
        {
          "type": "object",
          "properties": {
            "accountId": {
              "type": "string"
            },
            "draft": {
              "$ref": "#/$defs/LoginItemDraft"
            },
            "itemId": {
              "type": "string"
            },
            "type": {
              "type": "string",
              "const": "updateLoginItem"
            }
          },
          "additionalProperties": false,
          "required": [
            "type",
            "accountId",
            "itemId",
            "draft"
          ]
        },
        {
          "type": "object",
          "properties": {
            "accountId": {
              "type": "string"
            },
            "favorite": {
              "type": "boolean"
            },
            "itemId": {
              "type": "string"
            },
            "type": {
              "type": "string",
              "const": "setItemFavorite"
            }
          },
          "additionalProperties": false,
          "required": [
            "type",
            "accountId",
            "itemId",
            "favorite"
          ]
        },
        {
          "type": "object",
          "properties": {
            "accountId": {
              "type": "string"
            },
            "itemId": {
              "type": "string"
            },
            "type": {
              "type": "string",
              "const": "trashItem"
            }
          },
          "additionalProperties": false,
          "required": [
            "type",
            "accountId",
            "itemId"
          ]
        },
        {
          "type": "object",
          "properties": {
            "accountId": {
              "type": "string"
            },
            "itemId": {
              "type": "string"
            },
            "type": {
              "type": "string",
              "const": "restoreItem"
            }
          },
          "additionalProperties": false,
          "required": [
            "type",
            "accountId",
            "itemId"
          ]
        },
        {
          "type": "object",
          "properties": {
            "accountId": {
              "type": "string"
            },
            "itemId": {
              "type": "string"
            },
            "targetVaultId": {
              "type": "string"
            },
            "type": {
              "type": "string",
              "const": "moveItem"
            }
          },
          "additionalProperties": false,
          "required": [
            "type",
            "accountId",
            "itemId",
            "targetVaultId"
          ]
        },
        {
          "type": "object",
          "properties": {
            "accountId": {
              "type": "string"
            },
            "itemId": {
              "type": "string"
            },
            "type": {
              "type": "string",
              "const": "permanentlyDeleteItem"
            }
          },
          "additionalProperties": false,
          "required": [
            "type",
            "accountId",
            "itemId"
          ]
        },
        {
          "type": "object",
          "properties": {
            "accountId": {
              "type": "string"
            },
            "draft": {
              "$ref": "#/$defs/CreateShareDraft"
            },
            "itemId": {
              "type": "string"
            },
            "type": {
              "type": "string",
              "const": "createShare"
            }
          },
          "additionalProperties": false,
          "required": [
            "type",
            "accountId",
            "itemId",
            "draft"
          ]
        },
        {
          "type": "object",
          "properties": {
            "accountId": {
              "type": "string"
            },
            "operationId": {
              "type": "string"
            },
            "type": {
              "type": "string",
              "const": "acknowledgeShareResult"
            }
          },
          "additionalProperties": false,
          "required": [
            "type",
            "accountId",
            "operationId"
          ]
        }
      ]
    },
    "RuntimeResponse": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "accountId": {
              "type": "string"
            },
            "type": {
              "type": "string",
              "const": "signedIn"
            },
            "userId": {
              "type": "string"
            }
          },
          "additionalProperties": false,
          "required": [
            "type",
            "accountId",
            "userId"
          ]
        },
        {
          "description": "The Account access state this Device holds after a `Lock` or `SignOut`. An Account this\nDevice does not have answers `SignedOut`, because that is what it is.",
          "type": "object",
          "properties": {
            "access": {
              "$ref": "#/$defs/AccountAccessState"
            },
            "accountId": {
              "type": "string"
            },
            "type": {
              "type": "string",
              "const": "accessChanged"
            }
          },
          "additionalProperties": false,
          "required": [
            "type",
            "accountId",
            "access"
          ]
        },
        {
          "type": "object",
          "properties": {
            "itemId": {
              "type": "string"
            },
            "operationId": {
              "type": "string"
            },
            "replicaRevision": {
              "type": "string",
              "pattern": "^(?:0|[1-9][0-9]{0,18}|(?:1[0-7][0-9]{18}|18[0-3][0-9]{17}|184[0-3][0-9]{16}|1844[0-5][0-9]{15}|18446[0-6][0-9]{14}|184467[0-3][0-9]{13}|1844674[0-3][0-9]{12}|184467440[0-6][0-9]{10}|1844674407[0-2][0-9]{9}|18446744073[0-6][0-9]{8}|1844674407370[0-8][0-9]{6}|18446744073709[0-4][0-9]{5}|184467440737095[0-4][0-9]{4}|18446744073709550[0-9]{3}|18446744073709551[0-5][0-9]{2}|1844674407370955160[0-9]{1}|1844674407370955161[0-4][0-9]{0}|18446744073709551615))$"
            },
            "type": {
              "type": "string",
              "const": "accepted"
            }
          },
          "additionalProperties": false,
          "required": [
            "type",
            "operationId",
            "itemId",
            "replicaRevision"
          ]
        },
        {
          "type": "object",
          "properties": {
            "accountId": {
              "type": "string"
            },
            "operationId": {
              "type": "string"
            },
            "type": {
              "type": "string",
              "const": "shareResultAcknowledged"
            }
          },
          "additionalProperties": false,
          "required": [
            "type",
            "accountId",
            "operationId"
          ]
        },
        {
          "type": "object",
          "properties": {
            "failures": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/TeardownPhase"
              },
              "maxItems": 4
            },
            "scope": {
              "$ref": "#/$defs/TeardownScope"
            },
            "status": {
              "$ref": "#/$defs/TeardownStatus"
            },
            "type": {
              "type": "string",
              "const": "teardown"
            }
          },
          "additionalProperties": false,
          "required": [
            "type",
            "scope",
            "status"
          ]
        }
      ]
    },
    "RuntimeStatusProjection": {
      "type": "object",
      "properties": {
        "accountId": {
          "type": [
            "string",
            "null"
          ]
        },
        "accounts": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/AccountStatus"
          }
        },
        "closed": {
          "type": "boolean"
        },
        "revision": {
          "type": "string",
          "pattern": "^(?:0|[1-9][0-9]{0,18}|(?:1[0-7][0-9]{18}|18[0-3][0-9]{17}|184[0-3][0-9]{16}|1844[0-5][0-9]{15}|18446[0-6][0-9]{14}|184467[0-3][0-9]{13}|1844674[0-3][0-9]{12}|184467440[0-6][0-9]{10}|1844674407[0-2][0-9]{9}|18446744073[0-6][0-9]{8}|1844674407370[0-8][0-9]{6}|18446744073709[0-4][0-9]{5}|184467440737095[0-4][0-9]{4}|18446744073709550[0-9]{3}|18446744073709551[0-5][0-9]{2}|1844674407370955160[0-9]{1}|1844674407370955161[0-4][0-9]{0}|18446744073709551615))$"
        }
      },
      "required": [
        "accountId",
        "revision",
        "accounts",
        "closed"
      ]
    },
    "ShareAccessMode": {
      "type": "string",
      "enum": [
        "anyone",
        "email-restricted"
      ]
    },
    "ShareExpiration": {
      "type": "string",
      "enum": [
        "1hour",
        "1day",
        "7days",
        "14days",
        "30days"
      ]
    },
    "TeardownPhase": {
      "description": "Closed, bounded failure vocabulary. It deliberately carries no host detail or identity.",
      "type": "string",
      "enum": [
        "attachmentArtifacts",
        "hostCleanup",
        "platformStorage",
        "replica"
      ]
    },
    "TeardownScope": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "accountId": {
              "type": "string",
              "pattern": "^[\\s\\S]+$"
            },
            "type": {
              "type": "string",
              "const": "account"
            }
          },
          "additionalProperties": false,
          "required": [
            "type",
            "accountId"
          ]
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "device"
            }
          },
          "additionalProperties": false,
          "required": [
            "type"
          ]
        }
      ]
    },
    "TeardownStatus": {
      "type": "string",
      "enum": [
        "complete",
        "incomplete"
      ]
    },
    "VaultProjection": {
      "description": "One Vault as an Items reader needs it: enough to label it and to know what may be written.",
      "type": "object",
      "properties": {
        "icon": {
          "type": [
            "string",
            "null"
          ]
        },
        "imageUrl": {
          "type": [
            "string",
            "null"
          ]
        },
        "name": {
          "type": "string"
        },
        "role": {
          "description": "This Account's membership in the Vault. A host derives \"may I write an Item here\"\nfrom it (anything but `ReadOnly`), and the manage affordances an Owner or Admin has\nand a Member does not. The first slice's narrower create rule filters on the Vault\ntype as well.",
          "$ref": "#/$defs/VaultProjectionRole"
        },
        "vaultId": {
          "type": "string"
        },
        "vaultType": {
          "$ref": "#/$defs/VaultProjectionType"
        }
      },
      "required": [
        "vaultId",
        "name",
        "vaultType",
        "role"
      ]
    },
    "VaultProjectionRole": {
      "description": "One Account's membership in one Vault.\n\nThe values are the Server's own closed `VaultRole` set, spelled the way the Server spells\nthem, so a host that already renders a role does not need a second vocabulary and a\ntranslation table between the two.",
      "type": "string",
      "enum": [
        "owner",
        "admin",
        "member",
        "read-only"
      ]
    },
    "VaultProjectionType": {
      "type": "string",
      "enum": [
        "personal",
        "team"
      ]
    }
  },
  "$id": "urn:bittery:client-runtime:runtime-protocol"
}
