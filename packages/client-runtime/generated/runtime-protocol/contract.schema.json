{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "RuntimeProtocolContract",
  "type": "object",
  "properties": {
    "observation": {
      "$ref": "#/$defs/ObservationRequest"
    },
    "outcome": {
      "$ref": "#/$defs/RuntimeOutcome"
    },
    "projection": {
      "$ref": "#/$defs/RuntimeProjection"
    },
    "request": {
      "$ref": "#/$defs/RuntimeRequest"
    }
  },
  "required": [
    "request",
    "outcome",
    "observation",
    "projection"
  ],
  "$defs": {
    "AccountAccessState": {
      "type": "string",
      "enum": [
        "signedOut",
        "locked",
        "unlocked"
      ]
    },
    "AccountStatus": {
      "type": "object",
      "properties": {
        "access": {
          "$ref": "#/$defs/AccountAccessState"
        },
        "accountId": {
          "type": "string"
        },
        "failure": {
          "anyOf": [
            {
              "$ref": "#/$defs/RuntimeErrorCode"
            },
            {
              "type": "null"
            }
          ]
        },
        "replicaRevision": {
          "type": "string",
          "pattern": "^(?:0|[1-9][0-9]{0,18}|(?:1[0-7][0-9]{18}|18[0-3][0-9]{17}|184[0-3][0-9]{16}|1844[0-5][0-9]{15}|18446[0-6][0-9]{14}|184467[0-3][0-9]{13}|1844674[0-3][0-9]{12}|184467440[0-6][0-9]{10}|1844674407[0-2][0-9]{9}|18446744073[0-6][0-9]{8}|1844674407370[0-8][0-9]{6}|18446744073709[0-4][0-9]{5}|184467440737095[0-4][0-9]{4}|18446744073709550[0-9]{3}|18446744073709551[0-5][0-9]{2}|1844674407370955160[0-9]{1}|1844674407370955161[0-4][0-9]{0}|18446744073709551615))$"
        },
        "waitingReason": {
          "anyOf": [
            {
              "$ref": "#/$defs/AccountWaitingReason"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "accountId",
        "replicaRevision",
        "access",
        "failure"
      ]
    },
    "AccountWaitingReason": {
      "type": "string",
      "enum": [
        "reauthenticationRequired"
      ]
    },
    "CustomFieldKind": {
      "type": "string",
      "enum": [
        "text",
        "password",
        "email",
        "url"
      ]
    },
    "ItemProjectionStatus": {
      "type": "string",
      "enum": [
        "pending",
        "authoritative",
        "failed"
      ]
    },
    "ItemsProjection": {
      "type": "object",
      "properties": {
        "accountId": {
          "type": "string"
        },
        "items": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/LoginItemProjection"
          }
        },
        "replicaRevision": {
          "type": "string",
          "pattern": "^(?:0|[1-9][0-9]{0,18}|(?:1[0-7][0-9]{18}|18[0-3][0-9]{17}|184[0-3][0-9]{16}|1844[0-5][0-9]{15}|18446[0-6][0-9]{14}|184467[0-3][0-9]{13}|1844674[0-3][0-9]{12}|184467440[0-6][0-9]{10}|1844674407[0-2][0-9]{9}|18446744073[0-6][0-9]{8}|1844674407370[0-8][0-9]{6}|18446744073709[0-4][0-9]{5}|184467440737095[0-4][0-9]{4}|18446744073709550[0-9]{3}|18446744073709551[0-5][0-9]{2}|1844674407370955160[0-9]{1}|1844674407370955161[0-4][0-9]{0}|18446744073709551615))$"
        }
      },
      "required": [
        "accountId",
        "replicaRevision",
        "items"
      ]
    },
    "LoginCustomField": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "label": {
          "type": "string"
        },
        "type": {
          "$ref": "#/$defs/CustomFieldKind"
        },
        "value": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "label",
        "value",
        "type"
      ]
    },
    "LoginItemDraft": {
      "type": "object",
      "properties": {
        "customFields": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/LoginCustomField"
          }
        },
        "note": {
          "type": [
            "string",
            "null"
          ]
        },
        "notes": {
          "type": [
            "string",
            "null"
          ]
        },
        "password": {
          "type": [
            "string",
            "null"
          ]
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "title": {
          "type": "string"
        },
        "url": {
          "type": [
            "string",
            "null"
          ]
        },
        "urls": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "username": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "title"
      ]
    },
    "LoginItemProjection": {
      "type": "object",
      "properties": {
        "accountId": {
          "type": "string"
        },
        "createdAt": {
          "type": "string"
        },
        "customFields": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/LoginCustomField"
          }
        },
        "favorite": {
          "type": "boolean"
        },
        "itemId": {
          "type": "string"
        },
        "note": {
          "type": [
            "string",
            "null"
          ]
        },
        "notes": {
          "type": [
            "string",
            "null"
          ]
        },
        "password": {
          "type": [
            "string",
            "null"
          ]
        },
        "status": {
          "$ref": "#/$defs/ItemProjectionStatus"
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "title": {
          "type": "string"
        },
        "updatedAt": {
          "type": "string"
        },
        "url": {
          "type": [
            "string",
            "null"
          ]
        },
        "urls": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "username": {
          "type": [
            "string",
            "null"
          ]
        },
        "vaultId": {
          "type": "string"
        }
      },
      "required": [
        "accountId",
        "itemId",
        "vaultId",
        "title",
        "favorite",
        "createdAt",
        "updatedAt",
        "status"
      ]
    },
    "ObservationRequest": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "accountId": {
              "type": "string"
            },
            "type": {
              "type": "string",
              "const": "items"
            }
          },
          "required": [
            "type",
            "accountId"
          ]
        },
        {
          "type": "object",
          "properties": {
            "accountId": {
              "type": [
                "string",
                "null"
              ]
            },
            "type": {
              "type": "string",
              "const": "runtimeStatus"
            }
          },
          "required": [
            "type",
            "accountId"
          ]
        }
      ]
    },
    "RuntimeError": {
      "type": "object",
      "properties": {
        "code": {
          "$ref": "#/$defs/RuntimeErrorCode"
        },
        "message": {
          "type": "string"
        }
      },
      "required": [
        "code",
        "message"
      ]
    },
    "RuntimeErrorCode": {
      "type": "string",
      "enum": [
        "RUNTIME_CLOSED",
        "CANCELLED",
        "ACCOUNT_MISSING",
        "ACCOUNT_ALREADY_INSTALLED",
        "ACCOUNT_FAILED",
        "AUTHENTICATION_REQUIRED",
        "AUTHENTICATION_UNAVAILABLE",
        "INVARIANT_VIOLATION"
      ]
    },
    "RuntimeOutcome": {
      "description": "The declared envelope every external Runtime request answers with.\n\nSerde would otherwise emit its externally tagged `Result` spelling, an implicit wire shape no\ncontract describes. This adjacent tagging matches `RuntimeProjection`, and it keeps the\nsuccess payload intact: `RuntimeResponse` is itself internally tagged on `type`, so an\ninternally tagged envelope would collide with it.",
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "succeeded"
            },
            "value": {
              "$ref": "#/$defs/RuntimeResponse"
            }
          },
          "required": [
            "type",
            "value"
          ]
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "failed"
            },
            "value": {
              "$ref": "#/$defs/RuntimeError"
            }
          },
          "required": [
            "type",
            "value"
          ]
        }
      ]
    },
    "RuntimeProjection": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "items"
            },
            "value": {
              "$ref": "#/$defs/ItemsProjection"
            }
          },
          "required": [
            "type",
            "value"
          ]
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "runtimeStatus"
            },
            "value": {
              "$ref": "#/$defs/RuntimeStatusProjection"
            }
          },
          "required": [
            "type",
            "value"
          ]
        }
      ]
    },
    "RuntimeRequest": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "email": {
              "type": "string"
            },
            "insecureTransportConfirmed": {
              "type": "boolean"
            },
            "masterPassword": {
              "type": "string"
            },
            "secretKey": {
              "type": "string"
            },
            "serverUrl": {
              "type": "string"
            },
            "type": {
              "type": "string",
              "const": "signIn"
            }
          },
          "required": [
            "type",
            "serverUrl",
            "email",
            "masterPassword",
            "secretKey",
            "insecureTransportConfirmed"
          ]
        },
        {
          "type": "object",
          "properties": {
            "accountId": {
              "type": "string"
            },
            "masterPassword": {
              "type": "string"
            },
            "type": {
              "type": "string",
              "const": "quickUnlock"
            }
          },
          "required": [
            "type",
            "accountId",
            "masterPassword"
          ]
        },
        {
          "type": "object",
          "properties": {
            "accountId": {
              "type": "string"
            },
            "draft": {
              "$ref": "#/$defs/LoginItemDraft"
            },
            "type": {
              "type": "string",
              "const": "createLoginItem"
            },
            "vaultId": {
              "type": "string"
            }
          },
          "required": [
            "type",
            "accountId",
            "vaultId",
            "draft"
          ]
        }
      ]
    },
    "RuntimeResponse": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "accountId": {
              "type": "string"
            },
            "type": {
              "type": "string",
              "const": "signedIn"
            },
            "userId": {
              "type": "string"
            }
          },
          "required": [
            "type",
            "accountId",
            "userId"
          ]
        },
        {
          "type": "object",
          "properties": {
            "itemId": {
              "type": "string"
            },
            "operationId": {
              "type": "string"
            },
            "replicaRevision": {
              "type": "string",
              "pattern": "^(?:0|[1-9][0-9]{0,18}|(?:1[0-7][0-9]{18}|18[0-3][0-9]{17}|184[0-3][0-9]{16}|1844[0-5][0-9]{15}|18446[0-6][0-9]{14}|184467[0-3][0-9]{13}|1844674[0-3][0-9]{12}|184467440[0-6][0-9]{10}|1844674407[0-2][0-9]{9}|18446744073[0-6][0-9]{8}|1844674407370[0-8][0-9]{6}|18446744073709[0-4][0-9]{5}|184467440737095[0-4][0-9]{4}|18446744073709550[0-9]{3}|18446744073709551[0-5][0-9]{2}|1844674407370955160[0-9]{1}|1844674407370955161[0-4][0-9]{0}|18446744073709551615))$"
            },
            "type": {
              "type": "string",
              "const": "accepted"
            }
          },
          "required": [
            "type",
            "operationId",
            "itemId",
            "replicaRevision"
          ]
        }
      ]
    },
    "RuntimeStatusProjection": {
      "type": "object",
      "properties": {
        "accountId": {
          "type": [
            "string",
            "null"
          ]
        },
        "accounts": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/AccountStatus"
          }
        },
        "closed": {
          "type": "boolean"
        },
        "revision": {
          "type": "string",
          "pattern": "^(?:0|[1-9][0-9]{0,18}|(?:1[0-7][0-9]{18}|18[0-3][0-9]{17}|184[0-3][0-9]{16}|1844[0-5][0-9]{15}|18446[0-6][0-9]{14}|184467[0-3][0-9]{13}|1844674[0-3][0-9]{12}|184467440[0-6][0-9]{10}|1844674407[0-2][0-9]{9}|18446744073[0-6][0-9]{8}|1844674407370[0-8][0-9]{6}|18446744073709[0-4][0-9]{5}|184467440737095[0-4][0-9]{4}|18446744073709550[0-9]{3}|18446744073709551[0-5][0-9]{2}|1844674407370955160[0-9]{1}|1844674407370955161[0-4][0-9]{0}|18446744073709551615))$"
        }
      },
      "required": [
        "accountId",
        "revision",
        "accounts",
        "closed"
      ]
    }
  },
  "$id": "urn:bittery:client-runtime:runtime-protocol"
}
