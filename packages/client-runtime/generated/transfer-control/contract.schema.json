{
  "$defs": {
    "TransferControlRequest": {
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "headers": {
              "items": {
                "$ref": "#/$defs/TransferHeaderControl"
              },
              "maxItems": 64,
              "type": "array"
            },
            "maxChunkBytes": {
              "format": "uint32",
              "maximum": 262144,
              "minimum": 1,
              "type": "integer"
            },
            "maxResponseBytes": {
              "pattern": "^(0|[1-9][0-9]{0,19})$",
              "type": "string"
            },
            "transferId": {
              "maxLength": 128,
              "minLength": 1,
              "type": "string"
            },
            "type": {
              "const": "openDownload",
              "type": "string"
            },
            "url": {
              "maxLength": 8192,
              "minLength": 1,
              "type": "string"
            }
          },
          "required": [
            "type",
            "transferId",
            "url",
            "headers",
            "maxResponseBytes",
            "maxChunkBytes"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "transferId": {
              "maxLength": 128,
              "minLength": 1,
              "type": "string"
            },
            "type": {
              "const": "readDownloadChunk",
              "type": "string"
            }
          },
          "required": [
            "type",
            "transferId"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "accountId": {
              "maxLength": 256,
              "minLength": 1,
              "type": "string"
            },
            "artifactId": {
              "maxLength": 256,
              "minLength": 1,
              "type": "string"
            },
            "attachmentId": {
              "maxLength": 256,
              "minLength": 1,
              "type": "string"
            },
            "byteLength": {
              "pattern": "^(0|[1-9][0-9]{0,19})$",
              "type": "string"
            },
            "ciphertextSha256": {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            "generation": {
              "maxLength": 256,
              "minLength": 1,
              "type": "string"
            },
            "headers": {
              "items": {
                "$ref": "#/$defs/TransferHeaderControl"
              },
              "maxItems": 64,
              "type": "array"
            },
            "maxChunkBytes": {
              "format": "uint32",
              "maximum": 262144,
              "minimum": 1,
              "type": "integer"
            },
            "operationId": {
              "maxLength": 256,
              "minLength": 1,
              "type": "string"
            },
            "transferId": {
              "maxLength": 128,
              "minLength": 1,
              "type": "string"
            },
            "type": {
              "const": "beginUpload",
              "type": "string"
            },
            "url": {
              "maxLength": 8192,
              "minLength": 1,
              "type": "string"
            }
          },
          "required": [
            "type",
            "transferId",
            "accountId",
            "operationId",
            "attachmentId",
            "artifactId",
            "generation",
            "url",
            "headers",
            "ciphertextSha256",
            "byteLength",
            "maxChunkBytes"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "byteLength": {
              "format": "uint32",
              "maximum": 262144,
              "minimum": 1,
              "type": "integer"
            },
            "chunkSha256": {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            "transferId": {
              "maxLength": 128,
              "minLength": 1,
              "type": "string"
            },
            "type": {
              "const": "writeUploadChunk",
              "type": "string"
            }
          },
          "required": [
            "type",
            "transferId",
            "byteLength",
            "chunkSha256"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "transferId": {
              "maxLength": 128,
              "minLength": 1,
              "type": "string"
            },
            "type": {
              "const": "finishUpload",
              "type": "string"
            }
          },
          "required": [
            "type",
            "transferId"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "transferId": {
              "maxLength": 128,
              "minLength": 1,
              "type": "string"
            },
            "type": {
              "const": "cancelTransfer",
              "type": "string"
            }
          },
          "required": [
            "type",
            "transferId"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "Destroys one named Account's ciphertext spool. The identity is opaque to the host, so the\nonly constraint is that it names something.",
          "properties": {
            "accountId": {
              "pattern": "^[\\s\\S]+$",
              "type": "string"
            },
            "type": {
              "const": "deleteAccount",
              "type": "string"
            }
          },
          "required": [
            "type",
            "accountId"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "Destroys every Account's ciphertext spool on this Device.",
          "properties": {
            "type": {
              "const": "wipeDevice",
              "type": "string"
            }
          },
          "required": [
            "type"
          ],
          "type": "object"
        }
      ]
    },
    "TransferControlResponse": {
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "type": {
