{
  "name": "@bittery/crypto-napi",
  "version": "0.1.0",
  "description": "Native NAPI bindings for Bittery crypto (Node.js/Bun server)",
  "main": "index.js",
  "types": "index.d.ts",
  "napi": {
    "binaryName": "bittery-crypto",
    "targets": [
      "aarch64-apple-darwin",
      "x86_64-apple-darwin",
      "x86_64-unknown-linux-gnu",
      "aarch64-unknown-linux-gnu",
      "x86_64-unknown-linux-musl",
      "aarch64-unknown-linux-musl"
    ]
  },
  "scripts": {
    "artifacts": "napi artifacts",
    "build": "napi build --platform --release",
    "build:debug": "napi build --platform",
    "prepublishOnly": "napi prepublish -t npm",
    "test": "cargo test",
    "universal": "napi universal",
    "version": "napi version"
  },
  "files": [
    "index.js",
    "index.d.ts",
    "*.node"
  ],
  "devDependencies": {
    "@napi-rs/cli": "^3.5.1"
  },
  "engines": {
    "node": ">= 18"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/bittery/bittery",
    "directory": "packages/crypto/napi"
  },
  "license": "MIT"
}
