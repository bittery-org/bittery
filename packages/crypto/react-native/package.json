{
	"name": "@bittery/crypto-react-native",
	"version": "1.0.0",
	"description": "Generated UniFFI React Native bindings for Bittery crypto",
	"main": "src/index.ts",
	"types": "src/index.ts",
	"react-native": "src/index.ts",
	"files": [
		"android",
		"cpp",
		"ios",
		"src",
		"react-native.config.js"
	],
	"scripts": {
		"build:ios": "cd ../core && ../wasm/node_modules/.bin/ubrn build ios --config ubrn.config.yaml --release --and-generate",
		"build:ios:sim": "cd ../core && ../wasm/node_modules/.bin/ubrn build ios --config ubrn.config.yaml --release --sim-only --and-generate",
		"build:android": "cd ../core && ../wasm/node_modules/.bin/ubrn build android --config ubrn.config.yaml --release --and-generate --native-bindings",
		"generate:bindings": "cd ../core && ../wasm/node_modules/.bin/ubrn generate jsi bindings --library --ts-dir ../react-native/src/generated --cpp-dir ../react-native/cpp/generated target/release/libbittery_crypto_api.dylib",
		"check-types": "tsc --noEmit"
	},
	"keywords": [
		"react-native",
		"turbo-module",
		"crypto",
		"rust",
		"srp6a",
		"aes-gcm",
		"rsa"
	],
	"author": "Bittery",
	"license": "GPL-3.0-only",
	"repository": {
		"type": "git",
		"url": "https://github.com/bittery-org/bittery",
		"directory": "packages/crypto/react-native"
	},
	"homepage": "https://github.com/bittery-org/bittery",
	"peerDependencies": {
		"react": "*",
		"react-native": "*"
	},
	"dependencies": {
		"@ubjs/core": "0.31.0-3",
		"uniffi-bindgen-react-native": "0.31.0-3"
	},
	"devDependencies": {
		"@bittery/config": "workspace:*",
		"typescript": "~6.0.3"
	},
	"codegenConfig": {
		"name": "NativeBitteryCryptoSpec",
		"type": "modules",
		"jsSrcsDir": "src",
		"android": {
			"javaPackageName": "com.bittery.crypto"
		},
		"outputDir": {
			"android": "android/generated",
			"ios": "ios/generated"
		}
	}
}
