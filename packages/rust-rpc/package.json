{
	"name": "@bittery/rust-rpc",
	"version": "0.1.0",
	"type": "module",
	"sideEffects": false,
	"main": "./src/index.ts",
	"types": "./src/index.ts",
	"scripts": {
		"generate": "BITTERY_RUST_RPC_OUTPUT_DIR=$PWD/src/generated cargo run --manifest-path ../../apps/server-rust/Cargo.toml --bin write-bindings",
		"check-types": "tsc --noEmit"
	},
	"exports": {
		".": "./src/index.ts"
	},
	"dependencies": {
		"@qubit-rs/client": "catalog:"
	},
	"devDependencies": {
		"typescript": "^5.7.2"
	}
}
