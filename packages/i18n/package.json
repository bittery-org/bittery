{
	"name": "@bittery/i18n",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"main": "./src/index.ts",
	"types": "./src/index.ts",
	"exports": {
		".": "./src/index.ts",
		"./react": "./src/react/index.ts",
		"./react/browser": "./src/react/browser.ts",
		"./format/browser": "./src/format-browser.ts",
		"./paraglide/messages": {
			"types": "./src/paraglide/messages.d.ts",
			"default": "./src/paraglide/messages.js"
		},
		"./paraglide/runtime": {
			"types": "./src/paraglide/runtime.d.ts",
			"default": "./src/paraglide/runtime.js"
		},
		"./paraglide/registry": {
			"types": "./src/paraglide/registry.d.ts",
			"default": "./src/paraglide/registry.js"
		},
		"./paraglide/server": {
			"types": "./src/paraglide/server.d.ts",
			"default": "./src/paraglide/server.js"
		}
	},
	"scripts": {
		"build": "node ./scripts/generate-paraglide.mjs",
		"check-types": "tsc --noEmit",
		"check:keys": "node ./scripts/check-key-parity.mjs",
		"i18n:watch": "node ./scripts/watch-paraglide.mjs",
		"test": "bun test ./src"
	},
	"devDependencies": {
		"@inlang/paraglide-js": "^2.25.0",
		"@bittery/config": "workspace:*",
		"@types/react": "catalog:",
		"react": "catalog:",
		"typescript": "^5.7.2"
	},
	"peerDependencies": {
		"react": "^18.0.0 || ^19.0.0"
	}
}
