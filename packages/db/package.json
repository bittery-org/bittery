{
	"name": "@bittery/db",
	"type": "module",
	"exports": {
		".": {
			"default": "./src/index.ts"
		},
		"./*": {
			"default": "./src/*.ts"
		}
	},
	"scripts": {
		"db:create": "node ../../scripts/create-rust-migration.mjs",
		"db:migrate": "cargo run --manifest-path ../../apps/server/Cargo.toml --bin migrate",
		"db:test:create": "docker exec bittery-postgres psql -U postgres -tc \"SELECT 1 FROM pg_database WHERE datname = 'bittery_test'\" | grep -q 1 || docker exec bittery-postgres psql -U postgres -c \"CREATE DATABASE bittery_test\"",
		"db:test:migrate": "DATABASE_URL=postgres://postgres:password@localhost:5436/bittery_test cargo run --manifest-path ../../apps/server/Cargo.toml --bin migrate",
		"db:test:setup": "pnpm run db:test:create && pnpm run db:test:migrate",
		"db:start": "docker compose up -d",
		"db:watch": "docker compose up",
		"db:stop": "docker compose stop",
		"db:down": "docker compose down"
	},
	"devDependencies": {
		"@types/pg": "^8.15.6",
		"@bittery/config": "workspace:*"
	},
	"peerDependencies": {
		"typescript": "^5"
	},
	"dependencies": {
		"pg": "^8.16.3",
		"zod": "catalog:"
	}
}
