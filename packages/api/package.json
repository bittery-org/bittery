{
	"name": "@bittery/api",
	"exports": {
		".": {
			"default": "./src/index.ts"
		},
		"./*": {
			"default": "./src/*.ts"
		}
	},
	"type": "module",
	"scripts": {
		"test": "bun test --env-file ../../apps/server/.env src/__tests__",
		"test:auth": "bun test --env-file ../../apps/server/.env src/__tests__/auth.test.ts",
		"test:vault": "bun test --env-file ../../apps/server/.env src/__tests__/vault.test.ts",
		"test:team": "bun test --env-file ../../apps/server/.env src/__tests__/team.test.ts",
		"test:share": "bun test --env-file ../../apps/server/.env src/__tests__/share.test.ts"
	},
	"devDependencies": {
		"@bittery/config": "workspace:*"
	},
	"peerDependencies": {
		"typescript": "^5"
	},
	"dependencies": {
		"@trpc/server": "catalog:",
		"@trpc/client": "catalog:",
		"hono": "catalog:",
		"dotenv": "catalog:",
		"zod": "catalog:",
		"drizzle-orm": "catalog:",
		"@bittery/auth": "workspace:*",
		"@bittery/db": "workspace:*",
		"@bittery/crypto": "workspace:*",
		"@bittery/storage": "workspace:*",
		"nanoid": "^5.0.0"
	}
}
