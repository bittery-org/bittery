{
	"name": "@bittery/api",
	"exports": {
		".": {
			"default": "./src/index.ts"
		},
		"./storage/*": {
			"default": "./src/storage/*.ts"
		},
		"./*": {
			"default": "./src/*.ts"
		}
	},
	"type": "module",
	"scripts": {
		"test": "bun test --env-file ../../apps/server/.env.test src/__tests__",
		"test:auth": "bun test --env-file ../../apps/server/.env.test src/__tests__/auth.test.ts",
		"test:vault": "bun test --env-file ../../apps/server/.env.test src/__tests__/vault.test.ts",
		"test:team": "bun test --env-file ../../apps/server/.env.test src/__tests__/team.test.ts",
		"test:share": "bun test --env-file ../../apps/server/.env.test src/__tests__/share.test.ts",
		"test:sync": "bun test --env-file ../../apps/server/.env.test src/__tests__/sync.test.ts"
	},
	"devDependencies": {
		"@bittery/config": "workspace:*"
	},
	"peerDependencies": {
		"typescript": "^5"
	},
	"dependencies": {
		"@aws-sdk/client-s3": "^3.888.0",
		"@aws-sdk/s3-request-presigner": "^3.888.0",
		"@bittery/auth": "workspace:*",
		"@bittery/db": "workspace:*",
		"@trpc/client": "catalog:",
		"@trpc/server": "catalog:",
		"dotenv": "catalog:",
		"drizzle-orm": "catalog:",
		"hono": "catalog:",
		"nanoid": "^5.0.0",
		"stripe": "^18.5.0",
		"zod": "catalog:"
	}
}
