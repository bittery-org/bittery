DATABASE_URL=postgresql://postgres:postgres@localhost:5432/bittery
JWT_SECRET=
CORS_ORIGIN=http://localhost:3000,http://localhost:3001,http://localhost:3003
TRUST_PROXY_MODE=none

# cloud | self-hosted
BITTERY_MODE=cloud

# Hosted cloud beta controls
BITTERY_CLOUD_PUBLIC_SIGNUP=false
BITTERY_CLOUD_BILLING_ENABLED=false

# Optional Stripe billing. Leave unset while hosted billing is disabled.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PERSONAL_MONTHLY=
STRIPE_PRICE_FAMILY_MONTHLY=
STRIPE_PRICE_TEAM_SEAT_MONTHLY=
WEB_APP_URL=http://localhost:3001

# Optional S3-compatible storage
BITTERY_STORAGE_ENDPOINT=
BITTERY_STORAGE_BUCKET=
BITTERY_STORAGE_ACCESS_KEY_ID=
BITTERY_STORAGE_SECRET_ACCESS_KEY=
BITTERY_STORAGE_REGION=auto
BITTERY_STORAGE_CDN_URL=
MINIO_ROOT_PASSWORD=

# Optional rate limiting and pub/sub
RATE_LIMIT_ADAPTER=auto
RATE_LIMIT_REDIS_URL=
REDIS_URL=
SHARE_LINK_DAILY_LIMIT=50

# Marketing build-time config
VITE_WEBAPP_URL=http://localhost:3001
VITE_SERVER_URL=http://localhost:3000
VITE_BILLING_MARKETING_ENABLED=false
