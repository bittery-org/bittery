# ============================================================
# Bittery Self-Hosted Configuration
# ============================================================
# Copy this file to .env and fill in the values.

# Exact release shared by the server and web images (for example, 0.5.0).
# Upgrade or roll back both images together; do not use latest for durable installs.
BITTERY_RELEASE=

# Your domain (required) — Caddy will auto-provision TLS
DOMAIN=bittery.example.com

# JWT secret for session tokens (required)
# Generate with: openssl rand -hex 32
JWT_SECRET=

# Self-hosted mode unlocks self-hosted entitlements and disables hosted billing.
BITTERY_MODE=self-hosted
BITTERY_CLOUD_PUBLIC_SIGNUP=false
BITTERY_CLOUD_BILLING_ENABLED=false

# ============================================================
# Database
# ============================================================
# Option 1: Use the built-in PostgreSQL (start with --profile builtin-db)
# Set a password for the built-in database:
DB_PASSWORD=

# Option 2: Bring your own database
# Set DATABASE_URL to override the built-in database connection:
# DATABASE_URL=postgresql://user:password@host:5432/bittery

# ============================================================
# Object Storage (optional — for image uploads)
# ============================================================
# Use the built-in MinIO (start with --profile storage)
# or configure an external S3-compatible provider:
# BITTERY_STORAGE_ENDPOINT=
# BITTERY_STORAGE_BUCKET=
# BITTERY_STORAGE_ACCESS_KEY_ID=
# BITTERY_STORAGE_SECRET_ACCESS_KEY=
# BITTERY_STORAGE_REGION=auto
# BITTERY_STORAGE_CDN_URL=

# MinIO root password (only if using built-in MinIO)
# MINIO_ROOT_PASSWORD=

# ============================================================
# Redis / Valkey (required whenever the server runs with NODE_ENV=production)
# ============================================================
# Use the built-in Valkey (start with --profile cache)
# or configure an external Redis/Valkey instance:
# REDIS_URL=redis://valkey:6379
