{
	"$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
	"vcs": {
		"enabled": false,
		"clientKind": "git",
		"useIgnoreFile": false
	},
	"files": {
		"ignoreUnknown": false,
		"includes": [
			"**",
			"!**/.next",
			"!**/.expo",
			"!**/.automaker",
			"!**/.claude",
			"!**/.agents",
			"!**/.tanstack",
			"!**/.output",
			"!**/android",
			"!**/ios",
			"!**/node_modules",
			"!**/test-results",
			"!**/dist",
			"!**/build",
			"!packages/crypto/react-native",
			"!packages/crypto/wasm",
			"!packages/ui/src/components",
			"!docs/design-explorations",
			"!**/target",
			"!**/.turbo",
			"!**/dev-dist",
			"!**/.zed",
			"!**/.vscode",
			"!**/routeTree.gen.ts",
			"!packages/api-contract/openapi.v1.json",
			"!packages/api-contract/src/generated",
			"!**/src-tauri",
			"!**/.nuxt",
			"!bts.jsonc",
			"!**/.expo",
			"!**/.wrangler",
			"!**/.alchemy",
			"!**/.svelte-kit",
			"!**/wrangler.jsonc",
			"!**/.source",
			"!**/playwright-report",
			"!**/paraglide",
			"!**/project.inlang",
			"!packages/shared/src/__tests__/fixtures"
		]
	},
	"formatter": {
		"enabled": true,
		"indentStyle": "tab"
	},
	"assist": { "actions": { "source": { "organizeImports": "on" } } },
	"linter": {
		"enabled": true,
		"rules": {
			"recommended": true,
			"correctness": {
				"useExhaustiveDependencies": "info"
			},
			"suspicious": {
				"noExplicitAny": "off",
				"noUnknownAtRules": "off"
			},
			"nursery": {
				"useSortedClasses": {
					"level": "warn",
					"fix": "safe",
					"options": {
						"functions": ["clsx", "cva", "cn"]
					}
				}
			},
			"style": {
				"noRestrictedImports": {
					"level": "error",
					"options": {
						"paths": {
							"@bittery/core/hooks/auth": "Removed alias. Import from \"@bittery/core/services/auth-service\" instead.",
							"@bittery/core/hooks/utils": "Removed barrel over compatibility wrappers. Import the underlying service from \"@bittery/core/services/*\" instead.",
							"@bittery/core/hooks/services": "Removed forwarder. Import from \"@bittery/core/hooks/services/autolock-web\" or \"@bittery/core/hooks/services/autolock-mobile\" instead.",
							"@bittery/core/types": "Removed cross-package alias. Import from \"@bittery/types\" instead.",
							"@bittery/core/core-context": "Removed subpath export. Import from the \"@bittery/core\" root entry instead."
						}
					}
				},
				"noParameterAssign": "error",
				"useAsConstAssertion": "error",
				"useDefaultParameterLast": "error",
				"useEnumInitializers": "error",
				"useSelfClosingElements": "error",
				"useSingleVarDeclarator": "error",
				"noUnusedTemplateLiteral": "error",
				"useNumberNamespace": "error",
				"noInferrableTypes": "error",
				"noUselessElse": "error"
			}
		}
	},
	"javascript": {
		"formatter": {
			"quoteStyle": "double"
		}
	},
	"css": {
		"parser": {
			"tailwindDirectives": true
		}
	}
}
