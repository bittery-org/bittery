{
	"$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
	"vcs": {
		"enabled": false,
		"clientKind": "git",
		"useIgnoreFile": false
	},
	"files": {
		"ignoreUnknown": false,
		"includes": [
			"**",
			"!**/.next",
			"!**/.expo",
			"!**/.automaker",
			"!**/.claude",
			"!**/.agents",
			"!**/.tanstack",
			"!**/.output",
			"!**/android",
			"!**/ios",
			"!**/node_modules",
			"!**/test-results",
			"!**/dist",
			"!**/build",
			"!packages/crypto/android/generated",
			"!packages/crypto/wasm",
			"!spikes/*/plugins/*/permissions",
			"!packages/ui/src/components",
			"!docs/design-explorations",
			"!**/target",
			"!**/.turbo",
			"!**/dev-dist",
			"!**/.zed",
			"!**/.vscode",
			"!**/routeTree.gen.ts",
			"!**/expo-env.d.ts",
			"!packages/api-contract/openapi.v1.json",
			"!packages/api-contract/src/generated",
			"!packages/client-runtime/generated",
			"!apps/desktop/src/generated",
			"!apps/server/.sqlx",
			"!**/src-tauri",
			"!**/.nuxt",
			"!bts.jsonc",
			"!**/.expo",
			"!**/.wrangler",
			"!**/.alchemy",
			"!**/.svelte-kit",
			"!**/wrangler.jsonc",
			"!**/.source",
			"!**/playwright-report",
			"!**/paraglide",
			"!**/project.inlang",
			"!apps/web/src/lib/import/__tests__/fixtures"
		]
	},
	"formatter": {
		"enabled": true,
		"indentStyle": "tab"
	},
	"assist": { "actions": { "source": { "organizeImports": "on" } } },
	"linter": {
		"enabled": true,
		"rules": {
			"recommended": true,
			"correctness": {
				"useExhaustiveDependencies": "info"
			},
			"suspicious": {
				"noExplicitAny": "off",
				"noUnknownAtRules": "off"
			},
			"nursery": {
				"useSortedClasses": {
					"level": "warn",
					"fix": "safe",
					"options": {
						"functions": ["clsx", "cva", "cn"]
					}
				}
			},
			"style": {
				"noRestrictedImports": {
					"level": "error",
					"options": {
						"paths": {
							"@bittery/core/hooks/auth": "Removed alias. Import from \"@bittery/core/services/auth-service\" instead.",
							"@bittery/core/hooks/utils": "Removed barrel over compatibility wrappers. Import the underlying service from \"@bittery/core/services/*\" instead.",
							"@bittery/core/hooks/services": "Removed forwarder. Import from \"@bittery/core/hooks/services/autolock-web\" or \"@bittery/core/hooks/services/autolock-mobile\" instead.",
							"@bittery/core/types": "Removed cross-package alias. Import from \"@bittery/types\" instead.",
							"@bittery/core/core-context": "Removed subpath export. Import from the \"@bittery/core\" root entry instead.",
							"@bittery/api-contract/src/generated/schema": "Import server types from @bittery/api-contract's public exports, never the generated schema directly.",
							"@bittery/crypto-wasm": "Only @bittery/crypto-port may import generated crypto bindings."
						},
						"patterns": [
							{
								"group": ["@bittery/api-contract/src/generated/**"],
								"message": "Import server types from @bittery/api-contract's public exports, never the generated schema directly."
							},
							{
								"group": ["@bittery/crypto-wasm/**"],
								"message": "Only @bittery/crypto-port may import generated crypto bindings."
							}
						]
					}
				},
				"noParameterAssign": "error",
				"useAsConstAssertion": "error",
				"useDefaultParameterLast": "error",
				"useEnumInitializers": "error",
				"useSelfClosingElements": "error",
				"useSingleVarDeclarator": "error",
				"noUnusedTemplateLiteral": "error",
				"useNumberNamespace": "error",
				"noInferrableTypes": "error",
				"noUselessElse": "error"
			}
		}
	},
	"javascript": {
		"formatter": {
			"quoteStyle": "double"
		}
	},
	"css": {
		"parser": {
			"tailwindDirectives": true
		}
	},
	"overrides": [
		{
			"includes": ["apps/*/public/**/*.svg"],
			"linter": {
				"rules": {
					"a11y": {
						"noSvgWithoutTitle": "off"
					}
				}
			}
		},
		{
			"includes": ["apps/extension/src/background/desktop-protocol.ts"],
			"linter": {
				"rules": {
					"style": {
						"noRestrictedImports": "off"
					}
				}
			}
		},
		{
			"includes": ["packages/crypto/port/**"],
			"linter": {
				"rules": {
					"style": {
						"noRestrictedImports": "off"
					}
				}
			}
		}
	]
}
