<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.USE_BIOMETRIC" />
    <uses-permission android:name="android.permission.USE_FINGERPRINT" />

    <application>
        <!--
            Credential Provider Service (API 34+)

            CRITICAL: Do NOT add android:process attribute to this service!

            The BitteryCredentialProviderService shares VaultStateManager with the main app
            to access the Master Unlock Key (MUK) for decrypting credentials. Adding a
            separate process would create an isolated VaultStateManager singleton that
            cannot access the MUK set by the React Native layer.

            The service intentionally runs in the main app process to enable:
            1. Shared VaultStateManager for MUK access
            2. Shared MukEscrowManager for biometric unlock
            3. Shared Room database access
        -->
        <service
            android:name=".service.BitteryCredentialProviderService"
            android:enabled="true"
            android:exported="true"
            android:label="Bittery"
            android:icon="@mipmap/ic_launcher"
            android:permission="android.permission.BIND_CREDENTIAL_PROVIDER_SERVICE"
            tools:targetApi="upside_down_cake">
            <intent-filter>
                <action android:name="android.service.credentials.CredentialProviderService" />
            </intent-filter>
            <meta-data
                android:name="android.credentials.provider"
                android:resource="@xml/credential_provider" />
        </service>

        <service
            android:name=".service.BitteryAutofillService"
            android:enabled="true"
            android:exported="true"
            android:label="Bittery"
            android:permission="android.permission.BIND_AUTOFILL_SERVICE"
            tools:targetApi="o">
            <intent-filter>
                <action android:name="android.service.autofill.AutofillService" />
            </intent-filter>
            <meta-data
                android:name="android.autofill"
                android:resource="@xml/autofill_service" />
        </service>

        <!-- Activity for credential selection with biometric authentication -->
        <activity
            android:name=".activity.GetCredentialsActivity"
            android:exported="false"
            android:theme="@style/Theme.Bittery.CredentialProvider"
            android:excludeFromRecents="true"
            android:noHistory="true" />

        <activity
            android:name=".activity.AutofillAuthActivity"
            android:exported="false"
            android:theme="@style/Theme.Bittery.CredentialProvider"
            android:excludeFromRecents="true"
            android:noHistory="true" />
    </application>

</manifest>
