{
	/* Bittery's strict base first, Expo's on top: Expo owns the React Native
	   platform knobs (module "preserve", customConditions, moduleDetection and
	   the native-build excludes) and must win where the two overlap. */
	"extends": ["@bittery/config/tsconfig.base.json", "expo/tsconfig.base"],
	"compilerOptions": {
		"allowImportingTsExtensions": true,
		// Not a bun package; drop the base's ["bun"] rather than pull Bun's
		// globals into a React Native runtime.
		"types": [],
		"paths": {
			"@/*": ["./src/*"]
		}
	},
	"include": [
		"**/*.ts",
		"**/*.tsx",
		".expo/types/**/*.ts",
		"env.d.ts",
		"expo-env.d.ts"
	]
}
