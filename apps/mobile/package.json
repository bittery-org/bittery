{
	"name": "mobile",
	"private": true,
	"version": "0.1.0",
	"main": "expo-router/entry",
	"scripts": {
		"dev": "expo run:android --no-bundler && expo start --clear",
		"dev:build": "pnpm --workspace-root run build:crypto-android && expo prebuild && expo run:android --no-bundler",
		"dev:clear": "expo start --clear",
		"android": "pnpm --workspace-root run build:crypto-android && expo run:android",
		"android:release:build": "cd android && ./gradlew assembleRelease",
		"android:release:install": "adb install -r android/app/build/outputs/apk/release/app-release.apk",
		"ports": "adb reverse tcp:3000 tcp:3000 && adb reverse tcp:8081 tcp:8081",
		"ios": "pnpm --workspace-root run build:crypto-ios && expo run:ios",
		"eas-build-post-install": "../../scripts/build-mobile-crypto.sh",
		"build:eas": "eas build",
		"build:preview": "eas build --profile preview",
		"build:production": "eas build --profile production",
		"check-types": "tsc --noEmit"
	},
	"dependencies": {
		"@bittery/core": "workspace:*",
		"@bittery/crypto-port": "workspace:*",
		"@bittery/crypto-react-native": "workspace:*",
		"@bittery/i18n": "workspace:*",
		"@bittery/shared": "workspace:*",
		"@bittery/storage": "workspace:*",
		"@bittery/sync": "workspace:*",
		"@craftzdog/react-native-buffer": "^6.1.2",
		"@expo/metro-runtime": "^57.0.8",
		"@gorhom/bottom-sheet": "^5.2.9",
		"@react-native-async-storage/async-storage": "^2.2.0",
		"@react-native-community/netinfo": "^12.0.1",
		"@react-native-community/slider": "^5.2.0",
		"@tanstack/react-query": "^5.101.4",
		"expo": "~57.0.11",
		"expo-blur": "^57.0.2",
		"expo-build-properties": "^57.0.9",
		"expo-camera": "~57.0.3",
		"expo-clipboard": "~57.0.1",
		"expo-constants": "~57.0.9",
		"expo-crypto": "~57.0.1",
		"expo-document-picker": "^57.0.1",
		"expo-file-system": "^57.0.2",
		"expo-image": "^57.0.2",
		"expo-linking": "^57.0.5",
		"expo-local-authentication": "~57.0.2",
		"expo-router": "~57.0.11",
		"expo-secure-store": "~57.0.1",
		"expo-sharing": "^57.0.10",
		"expo-splash-screen": "~57.0.5",
		"expo-sqlite": "~57.0.1",
		"expo-status-bar": "~57.0.1",
		"expo-updates": "~57.0.12",
		"heroui-native": "1.0.8",
		"lucide-react-native": "^0.525.0",
		"react": "catalog:",
		"react-dom": "catalog:",
		"react-native": "~0.86.2",
		"react-native-gesture-handler": "~2.32.0",
		"react-native-reanimated": "~4.5.3",
		"react-native-safe-area-context": "^5.8.1",
		"react-native-screens": "~4.27.0",
		"react-native-svg": "^15.15.5",
		"react-native-worklets": "0.11.3",
		"tailwind-merge": "^3.6.0",
		"tailwind-variants": "^3.3.1",
		"tailwindcss": "^4.3.3",
		"uniwind": "^1.10.1"
	},
	"devDependencies": {
		"@babel/core": "^7.29.7",
		"@bittery/config": "workspace:*",
		"@types/react": "catalog:",
		"@types/react-dom": "catalog:",
		"babel-preset-expo": "^57.0.6",
		"typescript": "~6.0.3"
	}
}
