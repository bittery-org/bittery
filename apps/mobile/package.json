		"@bittery/shared": "workspace:*",
		"@bittery/storage": "workspace:*",
		"@bittery/sync": "workspace:*",
		"@bittery/ui": "workspace:*",
		"@choochmeque/tauri-plugin-biometry-api": "^0.2.8",
		"@inlang/paraglide-js": "^2.23.2",
		"@tailwindcss/vite": "^4.3.3",
		"@tanstack/react-form": "^1.33.4",
		"@tanstack/react-query": "^5.101.4",
		"@tanstack/react-router": "^1.170.24",
		"@tauri-apps/api": "^2.11.1",
