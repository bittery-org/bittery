{
	"name": "mobile",
	"private": true,
	"version": "0.5.2",
	"type": "module",
	"scripts": {
		"check-types": "tsc --noEmit && pnpm run lint:promises",
		"lint:promises": "biome lint --only=nursery/noMisusedPromises src",
		"dev:vite": "vite",
		"dev": "node scripts/android-dev.mjs",
		"dev:desktop": "tauri dev",
		"build": "tsc && vite build",
		"tauri": "tauri",
		"android:dev": "pnpm run dev",
		"android:build": "tauri android build --debug --target aarch64 --apk",
		"ios:dev": "tauri ios dev",
		"ports": "adb reverse tcp:3000 tcp:3000 && adb reverse tcp:3040 tcp:3040"
	},
