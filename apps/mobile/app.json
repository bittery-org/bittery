{
	"expo": {
		"name": "bittery",
		"slug": "bittery",
		"version": "0.1.0",
		"orientation": "portrait",
		"icon": "./assets/ios-light.png",
		"scheme": "bittery",
		"userInterfaceStyle": "automatic",
		"newArchEnabled": true,
		"splash": {
			"image": "./assets/splash-icon-dark.png",
			"resizeMode": "contain",
			"backgroundColor": "#ffffff"
		},
		"ios": {
			"supportsTablet": true,
			"bundleIdentifier": "io.bittery.app",
			"infoPlist": {
				"NSFaceIDUsageDescription": "Bittery uses Face ID to securely unlock your vault",
				"NSCameraUsageDescription": "Bittery needs camera access to scan TOTP QR codes"
			},
			"associatedDomains": [
				"applinks:app.bittery.io",
				"webcredentials:app.bittery.io"
			],
			"icon": {
				"dark": "./assets/ios-dark.png",
				"light": "./assets/ios-light.png",
				"tinted": "./assets/ios-tinted.png"
			}
		},
		"_associatedDomains_backup": [
			"applinks:app.bittery.io",
			"webcredentials:app.bittery.io"
		],
		"_associatedDomains_note": "Move back to ios.associatedDomains when you have a paid Apple Developer account",
		"android": {
			"adaptiveIcon": {
				"foregroundImage": "./assets/adaptive-icon.png",
				"backgroundColor": "#ffffff"
			},
			"package": "io.bittery.app",
			"permissions": ["USE_BIOMETRIC", "USE_FINGERPRINT", "CAMERA"],
			"usesCleartextTraffic": true
		},
		"web": {
			"bundler": "metro",
			"output": "static",
			"favicon": "./assets/favicon.png"
		},
		"plugins": [
			"./plugins/with-android-local-properties",
			"expo-router",
			"expo-secure-store",
			"expo-local-authentication",
			[
				"expo-sqlite",
				{
					"enableFTS": true
				}
			],
			[
				"expo-camera",
				{
					"cameraPermission": "Allow Bittery to access your camera to scan TOTP QR codes"
				}
			],
			"./modules/credential-provider/app.plugin.js"
		],
		"experiments": {
			"typedRoutes": true
		},
		"extra": {
			"router": {
				"origin": false
			},
			"eas": {
				"projectId": "your-project-id"
			}
		},
		"updates": {
			"url": "https://u.expo.dev/your-project-id"
		},
		"runtimeVersion": {
			"policy": "appVersion"
		}
	}
}
