{
	"expo": {
		"name": "bittery",
		"slug": "bittery",
		"version": "0.5.1",
		"orientation": "portrait",
		"icon": "./assets/ios-light.png",
		"scheme": "bittery",
		"userInterfaceStyle": "automatic",
		"ios": {
			"supportsTablet": true,
			"bundleIdentifier": "io.bittery.app",
			"infoPlist": {
				"NSFaceIDUsageDescription": "Bittery uses Face ID to securely unlock your vault",
				"NSCameraUsageDescription": "Bittery needs camera access to scan TOTP QR codes"
			},
			"associatedDomains": [
				"applinks:app.bittery.io",
				"webcredentials:app.bittery.io"
			],
			"icon": {
				"dark": "./assets/ios-dark.png",
				"light": "./assets/ios-light.png",
				"tinted": "./assets/ios-tinted.png"
			}
		},
		"android": {
			"adaptiveIcon": {
				"foregroundImage": "./assets/adaptive-icon.png",
				"backgroundColor": "#ffffff"
			},
			"package": "io.bittery.app",
			"permissions": ["USE_BIOMETRIC", "USE_FINGERPRINT", "CAMERA"]
		},
		"web": {
			"bundler": "metro",
			"output": "static",
			"favicon": "./assets/favicon.png"
		},
		"plugins": [
			"./plugins/with-android-local-properties",
			"expo-router",
			"expo-secure-store",
			"expo-local-authentication",
			[
				"expo-sqlite",
				{
					"enableFTS": true
				}
			],
			[
				"expo-camera",
				{
					"cameraPermission": "Allow Bittery to access your camera to scan TOTP QR codes"
				}
			],
			"./modules/credential-provider/app.plugin.js",
			[
				"expo-build-properties",
				{
					"android": {
						"usesCleartextTraffic": true
					}
				}
			],
			"expo-image",
			[
				"expo-splash-screen",
				{
					"image": "./assets/splash-icon-dark.png",
					"resizeMode": "contain",
					"backgroundColor": "#ffffff"
				}
			]
		],
		"experiments": {
			"typedRoutes": true
		},
		"extra": {
			"router": {
				"origin": false
			},
			"eas": {
				"projectId": "your-project-id"
			},
			"notes": {
				"associatedDomains": "ios.associatedDomains only builds with a paid Apple Developer account; clear the array to build on a free account."
			}
		},
		"updates": {
			"url": "https://u.expo.dev/your-project-id"
		},
		"runtimeVersion": {
			"policy": "appVersion"
		}
	}
}
