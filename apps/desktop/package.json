{
	"name": "desktop",
	"private": true,
	"version": "0.1.0",
	"type": "module",
	"scripts": {
		"check-types": "tsc --noEmit",
		"dev": "tauri dev",
		"dev:vite": "vite",
		"build:app": "tsc && vite build && tauri build",
		"build:pre": "cd src-tauri && cargo build --release --bin bittery-native-host",
		"build:prod": "BITTERY_EXTENSION_ID=$(grep BITTERY_EXTENSION_ID .env.production | cut -d '=' -f2) pnpm build",
		"build:release": "pnpm build:pre && pnpm build:app",
		"preview": "vite preview",
		"tauri": "tauri"
	},
	"dependencies": {
		"@bittery/api": "workspace:*",
		"@bittery/auth": "workspace:*",
		"@bittery/core": "workspace:*",
