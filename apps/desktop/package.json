{
	"name": "desktop",
	"private": true,
	"version": "0.5.2",
	"type": "module",
	"scripts": {
		"check-types": "tsc --noEmit",
		"generate:bindings": "cargo test --manifest-path src-tauri/Cargo.toml export_bindings",
		"test": "bun test src && node --test scripts/*.test.mjs",
		"dev": "tauri dev",
		"dev:vite": "vite",
		"build:native-host:dev": "cd src-tauri && cargo build --bin bittery-native-host",
		"build:app": "node scripts/build-desktop.mjs",
		"build:pre": "node scripts/prepare-native-host.mjs",
		"build:prod": "BITTERY_EXTENSION_ID=$({ grep -h BITTERY_EXTENSION_ID .env.production 2>/dev/null || grep -h BITTERY_EXTENSION_ID .env.production.example; } | cut -d '=' -f2) pnpm build",
		"build:release": "pnpm build:app",
		"preview": "vite preview",
		"tauri": "tauri"
	},
	"dependencies": {
		"@bittery/api-contract": "workspace:*",
		"@bittery/core": "workspace:*",
		"@bittery/crypto-port": "workspace:*",
		"@bittery/crypto-wasm": "workspace:*",
		"@bittery/i18n": "workspace:*",
		"@bittery/shared": "workspace:*",
		"@bittery/storage": "workspace:*",
		"@bittery/sync": "workspace:*",
		"@bittery/ui": "workspace:*",
		"@choochmeque/tauri-plugin-biometry-api": "^0.2.8",
		"@dnd-kit/core": "^6.3.1",
		"@dnd-kit/utilities": "^3.2.2",
		"@inlang/paraglide-js": "^2.23.2",
		"@tailwindcss/vite": "^4.3.3",
		"@tanstack/react-form": "^1.33.4",
		"@tanstack/react-query": "^5.101.4",
		"@tanstack/react-router": "^1.170.24",
		"@tauri-apps/api": "^2.11.1",
		"@tauri-apps/plugin-opener": "^2.5.4",
		"@tauri-apps/plugin-store": "^2.4.4",
		"lucide-react": "^0.525.0",
		"nanoid": "^6.0.1",
		"next-themes": "^0.4.6",
		"qrcode.react": "^4.2.0",
		"react": "catalog:",
		"react-dom": "catalog:",
		"tailwindcss": "^4.3.3",
		"tw-animate-css": "^1.4.0"
	},
	"devDependencies": {
		"@bittery/config": "workspace:*",
		"@tanstack/router-plugin": "^1.168.28",
		"@tauri-apps/cli": "^2.11.4",
		"@types/react": "catalog:",
		"@types/react-dom": "catalog:",
		"@vitejs/plugin-react": "^6.1.0",
		"typescript": "~5.8.3",
		"vite": "^8.2.2"
	}
}
