		"@bittery/storage": "workspace:*",
		"@bittery/sync": "workspace:*",
		"@bittery/types": "workspace:*",
		"@bittery/ui": "workspace:*",
		"@choochmeque/tauri-plugin-biometry-api": "^0.2.0",
		"@dnd-kit/core": "^6.3.1",
		"@dnd-kit/utilities": "^3.2.2",
		"@tailwindcss/vite": "^4.1.8",
		"@tanstack/react-form": "^1.23.5",
