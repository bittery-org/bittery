{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "bittery",
  "version": "0.1.0",
  "identifier": "com.bittery.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev:vite",
    "devUrl": "http://localhost:3002",
    "beforeBuildCommand": "tsc && vite build && cd src-tauri && cargo build --release --bin bittery-native-host",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "bittery",
        "width": 1000,
        "height": 700,
        "minWidth": 800,
        "minHeight": 600,
        "center": true,
        "hiddenTitle": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
