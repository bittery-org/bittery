{
	"name": "server",
	"main": "src/index.ts",
	"type": "module",
	"scripts": {
		"build": "tsdown",
		"check-types": "tsc -b",
		"compile": "bun build --compile --minify --sourcemap --bytecode ./src/index.ts --outfile server",
		"dev": "bun run --hot src/index.ts",
		"start": "bun run dist/index.mjs"
	},
	"dependencies": {
		"hono": "catalog:",
		"@trpc/server": "catalog:",
		"@hono/trpc-server": "^0.4.0",
		"dotenv": "catalog:",
		"zod": "catalog:",
		"drizzle-orm": "catalog:",
		"pg": "^8.16.3",
		"@bittery/api": "workspace:*",
		"@bittery/auth": "workspace:*",
		"@bittery/crypto-napi": "workspace:*",
		"@bittery/db": "workspace:*",
		"@bittery/favicon": "workspace:*",
		"@bittery/jobs": "workspace:*",
		"@bittery/pubsub": "workspace:*",
		"@bittery/rate-limit": "workspace:*",
		"@bittery/test-utils": "workspace:*"
	},
	"devDependencies": {
		"typescript": "^5.8.2",
		"@types/bun": "^1.2.6",
		"tsdown": "^0.16.5",
		"@bittery/config": "workspace:*"
	}
}
