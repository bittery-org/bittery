DATABASE_URL="postgres://postgres:password@localhost:5436/bittery"
JWT_SECRET="replace-with-a-random-secret-at-least-32-characters-long"
CORS_ORIGIN=http://localhost:3000,http://localhost:8080,http://localhost:5173,http://localhost:3001,http://localhost:3002
TRUST_PROXY_MODE=none
WEB_APP_URL=http://localhost:3001
BITTERY_MODE=cloud

# Optional: rate limiting backend
# - auto (default): use Redis/Valkey when RATE_LIMIT_REDIS_URL/REDIS_URL is set, otherwise Postgres
# - postgres: force Postgres backend
# - redis / valkey: force Redis-compatible backend
RATE_LIMIT_ADAPTER=auto
RATE_LIMIT_REDIS_URL=
REDIS_URL=
SHARE_LINK_DAILY_LIMIT=50

# Optional MinIO admin secret when using the docker "storage" profile
MINIO_ROOT_PASSWORD=

# Stripe (cloud mode only)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PERSONAL_MONTHLY=
STRIPE_PRICE_FAMILY_MONTHLY=
STRIPE_PRICE_TEAM_SEAT_MONTHLY=
