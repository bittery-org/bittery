{
	"name": "bittery",
	"private": true,
	"type": "module",
	"scripts": {
		"check": "biome check --write .",
		"dev": "turbo dev",
		"build": "turbo build",
		"check-types": "turbo check-types",
		"dev:desktop": "turbo -F desktop tauri:dev",
		"build:desktop": "turbo -F desktop tauri:build",
		"dev:web": "turbo -F web dev",
		"build:web": "turbo -F web build",
		"dev:server": "turbo -F server dev",
		"build:server": "turbo -F server build",
		"dev:extension": "turbo -F extension dev",
		"build:extension": "turbo -F extension build",
		"db:push": "turbo -F @bittery/db db:push",
		"db:studio": "turbo -F @bittery/db db:studio",
		"db:generate": "turbo -F @bittery/db db:generate",
		"db:migrate": "turbo -F @bittery/db db:migrate",
		"db:start": "turbo -F @bittery/db db:start",
		"db:watch": "turbo -F @bittery/db db:watch",
		"db:stop": "turbo -F @bittery/db db:stop",
		"db:down": "turbo -F @bittery/db db:down"
	},
	"dependencies": {
		"dotenv": "^17.2.2",
		"extension": "",
		"jsqr": "",
		"zod": "^4.1.13"
	},
	"devDependencies": {
		"turbo": "^2.5.4",
		"@biomejs/biome": "^2.2.0",
		"@types/bun": "^1.2.6"
	},
	"packageManager": "pnpm@10.18.3"
}
