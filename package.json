{
	"name": "bittery",
	"private": true,
	"license": "FSL-1.1-ALv2",
	"type": "module",
	"pnpm": {
		"overrides": {
			"react": "19.1.0",
			"react-dom": "19.1.0"
		}
	},
	"scripts": {
		"preinstall": "export $(cat .env | xargs) || true",
		"check": "biome check --write .",
		"check-types": "turbo check-types",
		"i18n:check": "pnpm --filter @bittery/i18n run check:keys",
		"shadcn": "pnpm --filter @bittery/ui run shadcn",
		"test": "turbo test",
		"dev": "turbo dev",
		"dev:desktop": "turbo -F desktop dev",
		"dev:web": "turbo -F web dev",
		"dev:server": "pnpm --filter server-rust run dev",
		"dev:server:once": "pnpm --filter server-rust run dev:once",
		"dev:extension": "turbo -F extension dev",
		"dev:mobile": "turbo -F mobile dev",
		"dev:marketing": "turbo -F marketing dev",
		"check:server-rust": "cargo check --manifest-path apps/server-rust/Cargo.toml",
		"generate:rust-rpc": "pnpm --filter @bittery/rust-rpc run generate",
		"generate:server-rust-bindings": "pnpm run generate:rust-rpc",
		"build": "turbo build",
		"build:desktop": "turbo -F desktop build:release",
		"build:web": "pnpm build:crypto-wasm && turbo -F web build",
		"build:server": "cargo build --manifest-path apps/server-rust/Cargo.toml --release",
		"build:extension": "turbo -F extension build:release",
		"build:mobile": "turbo -F mobile build",
		"build:crypto-wasm": "cd packages/crypto/core && ./build-wasm.sh",
		"build:crypto-napi": "cd packages/crypto/core && ./build-napi.sh",
		"build:crypto-android": "pnpm --filter @bittery/crypto-nitro run build:android",
		"build:crypto-ios": "pnpm --filter @bittery/crypto-nitro run build:ios",
		"build:crypto": "pnpm run build:crypto-wasm && pnpm run build:crypto-napi && pnpm run build:crypto-android && pnpm run build:crypto-ios",
		"db:create": "node ./scripts/create-rust-migration.mjs",
		"db:migrate": "cargo run --manifest-path apps/server-rust/Cargo.toml --bin migrate",
		"db:start": "docker compose -f apps/server-rust/docker-compose.db.yml up -d",
		"db:watch": "docker compose -f apps/server-rust/docker-compose.db.yml up",
		"db:test:setup": "docker exec bittery-postgres psql -U postgres -tc \"SELECT 1 FROM pg_database WHERE datname = 'bittery_test'\" | grep -q 1 || docker exec bittery-postgres psql -U postgres -c \"CREATE DATABASE bittery_test\" && DATABASE_URL=postgres://postgres:password@localhost:5436/bittery_test cargo run --manifest-path apps/server-rust/Cargo.toml --bin migrate",
		"db:stop": "docker compose -f apps/server-rust/docker-compose.db.yml stop",
		"db:down": "docker compose -f apps/server-rust/docker-compose.db.yml down",
		"start:server": "cargo run --manifest-path apps/server-rust/Cargo.toml --release",
		"stripe:webhooks": "stripe listen --forward-to http://localhost:3000/webhooks/stripe",
		"i18n:generate": "pnpm --filter @bittery/i18n run build"
	},
	"dependencies": {
		"dotenv": "^17.2.2",
		"zod": "^4.1.13"
	},
	"devDependencies": {
		"turbo": "^2.5.4",
		"@biomejs/biome": "^2.2.0",
		"@types/bun": "^1.2.6"
	},
	"packageManager": "pnpm@10.18.3"
}
