{
	"name": "bittery",
	"version": "0.4.1",
	"private": true,
	"license": "AGPL-3.0-only",
	"type": "module",
	"pnpm": {
		"overrides": {
			"react": "19.2.3",
			"react-dom": "19.2.3",
			"react-native": "0.86.2"
		},
		"patchedDependencies": {
			"uniffi-bindgen-react-native@0.31.0-3": "patches/uniffi-bindgen-react-native@0.31.0-3.patch"
		}
	},
	"scripts": {
		"preinstall": "node ./scripts/load-env.mjs",
		"setup:worktree": "./scripts/setup-worktree.sh",
		"check": "biome check . && pnpm --filter server check",
		"check:fix": "biome check --write --unsafe . && pnpm --filter server format",
		"check-types": "turbo check-types",
		"i18n:check": "pnpm --filter @bittery/i18n run check:keys",
		"shadcn": "pnpm --filter @bittery/ui run shadcn",
		"test": "turbo test",
		"test:server": "pnpm --filter server test",
		"dev": "turbo dev",
		"dev:desktop": "turbo -F desktop dev",
		"dev:web": "turbo -F web dev",
		"dev:server": "pnpm --filter server run dev",
		"dev:server:once": "pnpm --filter server run dev:once",
		"dev:extension": "turbo -F extension dev",
		"dev:mobile": "turbo -F mobile dev",
		"dev:marketing": "turbo -F marketing dev",
		"check:server": "cargo check --manifest-path apps/server/Cargo.toml",
		"generate:rust-rpc": "pnpm --filter @bittery/rust-rpc run generate",
		"generate:server-bindings": "pnpm run generate:rust-rpc",
		"build": "turbo build",
		"build:desktop": "turbo -F desktop build:release",
		"build:web": "pnpm build:crypto-wasm && turbo -F web build",
		"build:server": "cargo build --manifest-path apps/server/Cargo.toml --release",
		"build:extension": "turbo -F extension build:release",
		"build:mobile": "turbo -F mobile build",
		"build:crypto-wasm": "cd packages/crypto/core && ./build-wasm.sh",
		"build:crypto-android": "pnpm --filter @bittery/crypto-react-native run build:android",
		"build:crypto-ios": "pnpm --filter @bittery/crypto-react-native run build:ios",
		"build:crypto": "pnpm run build:crypto-wasm && pnpm run build:crypto-android && pnpm run build:crypto-ios",
		"db:check": "node ./scripts/check-migrations.mjs",
		"db:create": "node ./scripts/create-rust-migration.mjs",
		"db:migrate": "cargo run --manifest-path apps/server/Cargo.toml --bin migrate",
		"db:start": "docker compose -f apps/server/docker-compose.yml up -d",
		"db:watch": "docker compose -f apps/server/docker-compose.yml up",
		"db:test:setup": "docker exec bittery-postgres psql -U postgres -tc \"SELECT 1 FROM pg_database WHERE datname = 'bittery_test'\" | grep -q 1 || docker exec bittery-postgres psql -U postgres -c \"CREATE DATABASE bittery_test\" && DATABASE_URL=postgres://postgres:password@localhost:5436/bittery_test cargo run --manifest-path apps/server/Cargo.toml --bin migrate",
		"db:stop": "docker compose -f apps/server/docker-compose.yml stop",
		"db:down": "docker compose -f apps/server/docker-compose.yml down",
		"start:server": "cargo run --manifest-path apps/server/Cargo.toml --release",
		"stripe:webhooks": "stripe listen --forward-to http://localhost:3000/webhooks/stripe",
		"i18n:generate": "pnpm --filter @bittery/i18n run build",
		"version:sync": "node ./scripts/sync-version.mjs",
		"version:check": "node ./scripts/sync-version.mjs --check",
		"env:check": "node ./scripts/check-env-docs.mjs"
	},
	"dependencies": {
		"dotenv": "^17.2.2",
		"zod": "^4.1.13"
	},
	"devDependencies": {
		"turbo": "^2.5.4",
		"@biomejs/biome": "^2.2.0",
		"@types/bun": "^1.2.6"
	},
	"packageManager": "pnpm@10.18.3"
}
