{
	"$schema": "https://turbo.build/schema.json",
	"ui": "tui",
	"globalPassThroughEnv": [
		"ANDROID_HOME",
		"ANDROID_SDK_ROOT",
		"ANDROID_NDK_HOME",
		"ANDROID_NDK_ROOT",
		"NDK_HOME",
		"LLVM_READELF"
	],
	"tasks": {
		"build": {
			"dependsOn": ["^build"],
			"inputs": ["$TURBO_DEFAULT$", ".env*"],
			"outputs": ["dist/**", ".output/**"]
		},
		"build:release": {
			"dependsOn": ["^build"],
			"inputs": ["$TURBO_DEFAULT$", ".env*"],
			"outputs": ["dist/**", ".output/**", "src-tauri/target/**"]
		},
		"lint": {
			"dependsOn": ["^lint"]
		},
		"test": {
			"dependsOn": ["^build"],
			"cache": false
		},
		"test:e2e": {
			"dependsOn": ["^build"],
			"cache": false
		},
		"check-types": {
			"dependsOn": ["^check-types"]
		},
		"dev": {
			"cache": false,
			"persistent": true
		},
		"tauri": {
			"cache": false
		}
	}
}
