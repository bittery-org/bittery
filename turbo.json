{
	"$schema": "https://turbo.build/schema.json",
	"ui": "tui",
	"tasks": {
		"build": {
			"dependsOn": ["^build"],
			"inputs": ["$TURBO_DEFAULT$", ".env*"],
			"outputs": ["dist/**", ".output/**"]
		},
		"lint": {
			"dependsOn": ["^lint"]
		},
		"test": {
			"dependsOn": ["^build"],
			"cache": false
		},
		"check-types": {
			"dependsOn": ["^check-types"]
		},
		"dev": {
			"cache": false,
			"persistent": true
		},
		"tauri": {
			"cache": false
		},
		"tauri:dev": {
			"cache": false,
			"persistent": true,
			"dependsOn": ["^build"]
		},
		"tauri:build": {
			"cache": false,
			"dependsOn": ["^build"],
			"outputs": ["src-tauri/target/**"]
		}
	}
}
