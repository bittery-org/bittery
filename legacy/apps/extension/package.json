{
	"name": "extension",
	"private": true,
	"version": "0.5.2",
	"type": "module",
	"scripts": {
		"check-types": "tsc --noEmit",
		"test": "node ./scripts/run-tests.mjs",
		"dev": "node ./scripts/generate-manifest-locales.mjs && vite dev",
		"build:release": "node ./scripts/generate-manifest-locales.mjs && vite build",
		"preview": "vite preview",
		"test:e2e": "playwright test",
		"test:e2e:ui": "playwright test --ui",
