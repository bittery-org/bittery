		"@playwright/test": "^1.62.1",
		"@tailwindcss/vite": "^4.3.3",
		"@types/chrome": "^0.2.5",
		"@types/react": "catalog:",
		"@types/react-dom": "catalog:",
		"@vitejs/plugin-react": "^6.0.5",
		"playwright": "^1.62.1",
		"typescript": "^5.7.2",
		"vite": "^8.2.1"
