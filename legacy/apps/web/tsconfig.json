{
	"extends": "@bittery/config/tsconfig.base.json",
	"include": ["**/*.ts", "**/*.tsx"],
	"compilerOptions": {
		/* Vite build target: the app ships to browsers, not to a bundler-free
		   ESNext runtime, so pin below the base's ESNext. */
		"target": "ES2022",
		"lib": ["ES2022", "DOM", "DOM.Iterable"],
		"jsx": "react-jsx",
		// "bun" matches tsconfig.base.json: this package's tests run under
		// `bun test` and `include` covers them, so `bun:test` must be typed.
		"types": ["vite/client", "bun"],
		"noEmit": true,
		"noUncheckedSideEffectImports": true,
		"baseUrl": ".",
		"paths": {
			"@/*": ["./src/*"]
		}
	}
}
